# =============================================================================
# TikTok Viral Signal Detector - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to git (it's in .gitignore)
# =============================================================================

# =============================================================================
# Database Configuration
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tiktok_viral_detector
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Full database URL (alternative to individual settings)
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/tiktok_viral_detector

# =============================================================================
# TikTok API Configuration
# =============================================================================
# How to get ms_token:
# 1. Open TikTok in your browser (while logged in)
# 2. Open Developer Tools (F12)
# 3. Go to Application/Storage > Cookies > https://www.tiktok.com
# 4. Find the cookie named "ms_token" and copy its value
# 5. Paste it below

TIKTOK_MS_TOKEN=your_ms_token_from_browser_cookies_here

# Optional: If you encounter rate limiting, use a proxy
# Webshare offers 10 free datacenter proxies
# Format: http://username:password@proxy_host:port
PROXY_URL=

# =============================================================================
# Google Gemini API (for report generation)
# =============================================================================
# Get your free API key from: https://makersuite.google.com/app/apikey
# Free tier: 15 requests/min, 1500 requests/day

GEMINI_API_KEY=your_gemini_api_key_here

# Model configuration
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=1024

# =============================================================================
# File Storage Paths
# =============================================================================
# Where to temporarily store downloaded videos
VIDEO_STORAGE_PATH=/tmp/videos

# Where to store processed embeddings
EMBEDDING_STORAGE_PATH=./data/processed/embeddings

# Where to store transcripts
TRANSCRIPT_STORAGE_PATH=./data/processed/transcripts

# ChromaDB storage
CHROMADB_PATH=./data/chromadb

# =============================================================================
# Model Paths (after training in Colab)
# =============================================================================
XGBOOST_MODEL_PATH=./data/models/xgboost_model.pkl
NEURAL_NET_MODEL_PATH=./data/models/neural_net_model.pkl
SCALER_PATH=./data/models/feature_scaler.pkl

# =============================================================================
# Scraping Configuration
# =============================================================================
# Rate limiting (seconds)
MIN_REQUEST_DELAY=5
MAX_REQUEST_DELAY=10

# Maximum videos to scrape per creator
MAX_VIDEOS_PER_CREATOR=15

# Retry configuration
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_MULTIPLIER=2

# =============================================================================
# Video Processing Configuration
# =============================================================================
# Frame extraction rate (frames per second)
FRAME_EXTRACTION_FPS=3

# Maximum video duration to process (seconds)
MAX_VIDEO_DURATION=180

# Hook analysis window (seconds)
HOOK_ANALYSIS_WINDOW=3

# =============================================================================
# ML Model Configuration
# =============================================================================
# Prediction threshold for viral classification
VIRAL_PROBABILITY_THRESHOLD=0.7

# Ensemble model weights
NEURAL_NET_WEIGHT=0.6
XGBOOST_WEIGHT=0.4

# Minimum confidence to show prediction
MIN_CONFIDENCE_THRESHOLD=0.5

# =============================================================================
# Feature Engineering Configuration
# =============================================================================
# Analysis window for engagement features (days)
ENGAGEMENT_ANALYSIS_WINDOW_DAYS=30

# Minimum videos required for reliable prediction
MIN_VIDEOS_FOR_PREDICTION=5

# Z-score threshold for significant growth
GROWTH_ZSCORE_THRESHOLD=2.0

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=./logs/app.log

# Enable debug mode (more verbose logging)
DEBUG_MODE=false

# =============================================================================
# Streamlit Configuration
# =============================================================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# Enable caching
ENABLE_STREAMLIT_CACHE=true

# =============================================================================
# Development/Production Settings
# =============================================================================
ENVIRONMENT=development

# Set to true to run in safe mode (no actual API calls, use mock data)
SAFE_MODE=false

# Enable/disable specific agents for testing
ENABLE_SCRAPER_AGENT=true
ENABLE_VIDEO_ANALYSIS_AGENT=true
ENABLE_ENGAGEMENT_AGENT=true
ENABLE_PREDICTION_AGENT=true
ENABLE_REPORT_AGENT=true

# =============================================================================
# External Services (Optional)
# =============================================================================
# Sentry for error tracking (optional)
SENTRY_DSN=

# Analytics (optional)
ANALYTICS_ENABLED=false

# =============================================================================
# Security Settings
# =============================================================================
# Secret key for encryption (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here

# API rate limiting
API_RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# Experimental Features
# =============================================================================
# Enable experimental features
ENABLE_REAL_TIME_MONITORING=false
ENABLE_MULTI_PLATFORM=false
ENABLE_COMPETITOR_ANALYSIS=false

# =============================================================================
# Notes
# =============================================================================
# - Replace all "your_*_here" values with actual credentials
# - Keep this file secure and never commit it to version control
# - For production, use environment-specific .env files (.env.prod, .env.staging)
# - Some features (like real-time monitoring) are placeholders for future development
