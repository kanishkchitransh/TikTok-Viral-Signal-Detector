# Misc
# =============================================================================
# Backup files
*.backup
*.old

# Compressed files
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# Large files (should be tracked with Git LFS if needed)
*.bin

# =============================================================================
# Keep These Files
# =============================================================================
# Explicitly keep certain files that might match above patterns
!.gitkeep
!data/.gitkeep
!logs/.gitkeep
!data/sample/*
!docs/*.md
